
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#263d32">
  <meta name="description" content="Undangan pernikahan Ari Efraim Ginting dan Gina Sonia Br Sembiring, 7 November 2026.">
  <title>Undangan Pernikahan | Ari & Gina</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style>
    :root {
      --cream: #f8f3e9;
      --green: #263d32;
      --green-light: #405b49;
      --gold: #c9a65b;
      --text: #35443a;
      --white: #fffdf8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: var(--cream);
      color: var(--text);
      font-family: 'Poppins', sans-serif;
      line-height: 1.8;
    }

    h1, h2, h3 {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 500;
      line-height: 1.2;
    }

    h2 {
      font-size: clamp(2.2rem, 6vw, 3.4rem);
      color: var(--green);
    }

    p {
      font-size: .92rem;
    }

    a {
      color: inherit;
    }

    .section {
      padding: 85px 22px;
      text-align: center;
    }

    .container {
      width: 100%;
      max-width: 900px;
      margin: auto;
    }

    .eyebrow {
      color: var(--gold);
      text-transform: uppercase;
      letter-spacing: 4px;
      font-size: .72rem;
      margin-bottom: 16px;
    }

    .ornament {
      color: var(--gold);
      letter-spacing: 7px;
      margin: 18px 0;
    }

    .button {
      display: inline-block;
      background: var(--gold);
      color: #26352b;
      text-decoration: none;
      border: none;
      border-radius: 30px;
      padding: 12px 25px;
      font-family: inherit;
      font-size: .82rem;
      cursor: pointer;
      transition: .25s;
    }

    .button:hover {
      transform: translateY(-2px);
      opacity: .9;
    }

    /* SAMPUL */

    .cover {
      position: relative;
      min-height: 100svh;
      padding: 50px 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: var(--white);
      background:
        linear-gradient(rgba(24, 47, 37, .55), rgba(24, 47, 37, .82)),
        url('https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=1800&q=85')
        center / cover no-repeat;
      overflow: hidden;
    }

    .cover::before {
      content: "";
      position: absolute;
      inset: 15px;
      border: 1px solid rgba(218, 190, 124, .75);
      pointer-events: none;
    }

    .cover-content {
      position: relative;
      max-width: 600px;
      width: 100%;
      padding: 35px 10px;
    }

    .cover .eyebrow {
      color: #ead5a0;
    }

    .cover h1 {
      font-size: clamp(3.5rem, 12vw, 6.5rem);
      color: #f4dfaa;
      margin: 15px 0;
    }

    .cover .subtitle {
      max-width: 420px;
      margin: 0 auto 20px;
      font-weight: 300;
    }

    .cover .ornament {
      font-size: 1.3rem;
    }

    .guest {
      margin: 25px auto;
      font-size: .85rem;
    }

    .guest strong {
      display: block;
      font-size: 1rem;
      color: #f4dfaa;
      margin-top: 5px;
    }

    /* NAVIGASI */

    .nav {
      position: sticky;
      top: 0;
      z-index: 20;
      background: rgba(38, 61, 50, .97);
      display: flex;
      justify-content: center;
      gap: 23px;
      padding: 12px 8px;
      overflow-x: auto;
    }

    .nav a {
      color: white;
      text-decoration: none;
      font-size: .72rem;
      white-space: nowrap;
    }

    /* PEMBUKA */

    .intro {
      background: var(--white);
    }

    .intro p {
      max-width: 650px;
      margin: 15px auto;
    }

    .couple-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 25px;
      margin-top: 40px;
    }

    .person {
      padding: 28px 14px;
      border: 1px solid #dfd0a7;
      border-radius: 100px 100px 15px 15px;
      background: var(--cream);
    }

    .person .initial {
      width: 90px;
      height: 90px;
      border: 1px solid var(--gold);
      border-radius: 50%;
      display: grid;
      place-items: center;
      margin: 0 auto 18px;
      font-family: 'Cormorant Garamond', serif;
      font-size: 2.4rem;
      color: var(--green);
    }

    .person h3 {
      font-size: 1.8rem;
      margin-bottom: 10px;
    }

    .person p {
      font-size: .78rem;
    }

    /* FOTO PEMANDANGAN */

    .landscape {
      min-height: 310px;
      background:
        linear-gradient(rgba(28, 48, 38, .25), rgba(28, 48, 38, .45)),
        url('https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1600&q=85')
        center / cover no-repeat;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 30px;
      color: white;
      text-align: center;
    }

    .landscape h2 {
      color: white;
    }

    /* HITUNG MUNDUR */

    .countdown {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
      margin: 30px 0;
    }

    .time-box {
      background: var(--green);
      color: white;
      border-radius: 12px;
      padding: 16px 12px;
      min-width: 76px;
    }

    .time-box strong {
      display: block;
      font-family: 'Cormorant Garamond', serif;
      font-size: 2rem;
      color: #f2d99c;
    }

    .time-box span {
      font-size: .68rem;
    }

    /* ACARA */

    .events {
      background: #ede8da;
    }

    .event-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-top: 35px;
    }

    .event-card {
      padding: 30px 20px;
      background: var(--white);
      border-radius: 15px;
      border-top: 3px solid var(--gold);
    }

    .event-card h3 {
      font-size: 2rem;
      margin: 10px 0;
      color: var(--green);
    }

    .event-card p {
      margin: 9px 0;
    }

    /* GALERI */

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-top: 30px;
    }

    .gallery-grid img {
      display: block;
      width: 100%;
      height: 240px;
      object-fit: cover;
      border-radius: 12px;
      background: #e4ddcb;
    }

    .gallery-note {
      margin-top: 20px;
      font-size: .78rem;
      opacity: .8;
    }

    /* RSVP */

    .rsvp {
      background: var(--green);
      color: white;
    }

    .rsvp h2 {
      color: white;
    }

    .rsvp form {
      max-width: 480px;
      margin: 30px auto 0;
      text-align: left;
    }

    .rsvp label {
      display: block;
      font-size: .8rem;
      margin: 13px 0 5px;
    }

    .rsvp input,
    .rsvp select,
    .rsvp textarea {
      width: 100%;
      border: 1px solid #d7c99f;
      border-radius: 8px;
      padding: 12px;
      font: inherit;
      font-size: .85rem;
      background: var(--white);
    }

    .rsvp .button {
      width: 100%;
      margin-top: 20px;
    }

    /* PENUTUP */

    .closing {
      background: var(--white);
    }

    .closing h2 {
      margin: 15px 0;
    }

    footer {
      background: #1b3026;
      color: white;
      text-align: center;
      padding: 25px 15px;
      font-size: .75rem;
    }

    /* MUSIK */

    .music-button {
      position: fixed;
      right: 16px;
      bottom: 18px;
      z-index: 30;
      width: 48px;
      height: 48px;
      border-radius: 50%;
      border: 1px solid var(--gold);
      background: var(--green);
      color: white;
      font-size: 1.2rem;
      cursor: pointer;
      box-shadow: 0 3px 12px #0002;
    }

    @media (max-width: 600px) {
      .section {
        padding: 65px 18px;
      }

      .couple-grid,
      .event-grid {
        grid-template-columns: 1fr;
      }

      .person {
        max-width: 340px;
        width: 100%;
        margin: auto;
      }

      .gallery-grid img {
        height: 175px;
      }

      .nav {
        justify-content: flex-start;
        gap: 20px;
        padding-left: 15px;
      }
    }
  </style>
</head>

<body>

  <!-- SAMPUL UNDANGAN -->
  <section class="cover" id="home">
    <div class="cover-content">
      <p class="eyebrow">The Wedding Of</p>
      <div class="ornament">✿ ❧ ✿</div>

      <h1>Ari & Gina</h1>

      <p class="subtitle">
        Dengan penuh rasa syukur, kami mengundang
        Bapak/Ibu/Saudara/i untuk hadir di hari bahagia kami.
      </p>

      <p class="eyebrow">Sabtu, 7 November 2026</p>

      <div class="guest">
        Kepada Yth.
        <strong id="guestName">Bapak/Ibu/Saudara/i</strong>
      </div>

      <button class="button" id="openInvitation">
        ✉ Buka Undangan
      </button>
    </div>
  </section>

  <!-- MENU -->
  <nav class="nav" aria-label="Menu undangan">
    <a href="#home">Home</a>
    <a href="#couple">Mempelai</a>
    <a href="#date">Tanggal</a>
    <a href="#event">Acara</a>
    <a href="#gallery">Galeri</a>
    <a href="#rsvp">RSVP</a>
  </nav>

  <!-- PEMBUKA -->
  <section class="section intro" id="couple">
    <div class="container">
      <p class="eyebrow">Assalamu'alaikum Warahmatullahi Wabarakatuh</p>
      <h2>Dengan Memohon Rahmat Allah SWT</h2>
      <div class="ornament">❧ ✿ ❧</div>

  </section>

  <!-- PEMANDANGAN GUNUNG -->
  <section class="landscape">
    <div>
      <p class="eyebrow">Two Hearts, One Promise</p>
      <h2>Awal dari Selamanya</h2>
      <div class="ornament">✿ ❧ ✿</div>
      <p>Semoga Allah menyatukan kami dalam cinta dan kebaikan.</p>
    </div>
  </section>

  <!-- TANGGAL DAN COUNTDOWN -->
  <section class="section" id="date">
    <div class="container">
      <p class="eyebrow">Save The Date</p>
      <h2>7 November 2026</h2>
      <div class="ornament">❧ ✿ ❧</div>

      <p>Sabtu</p>

      <div class="countdown" aria-label="Hitung mundur pernikahan">
        <div class="time-box">
          <strong id="days">--</strong>
          <span>Hari</span>
        </div>
        <div class="time-box">
          <strong id="hours">--</strong>
          <span>Jam</span>
        </div>
        <div class="time-box">
          <strong id="minutes">--</strong>
          <span>Menit</span>
        </div>
        <div class="time-box">
          <strong id="seconds">--</strong>
          <span>Detik</span>
        </div>
      </div>

      <a class="button" href="#event">Lihat Detail Acara</a>
    </div>
  </section>

  <!-- DETAIL ACARA -->
  <section class="section events" id="event">
    <div class="container">
      <p class="eyebrow">Wedding Celebration</p>
      <h2>Waktu & Tempat</h2>
      <div class="ornament">✿ ❧ ✿</div>

      <div class="event-grid">
        <article class="event-card">
          <div class="ornament">♡</div>
          <h3>Akad Nikah</h3>
          <p><strong>Sabtu, 10 October 2026</strong></p>
          <p>Waktu: <em> 13:00 </em></p>
          <p>Tempat: <em> MEDAN Desa Serbajadi </em></p>
        </article>

        <article class="event-card">
          <div class="ornament">✿</div>
          <h3>Resepsi</h3>
          <p><strong>Sabtu, 7 November 2026</strong></p>
          <p>Waktu: <em>Isi 09:00 - Selesai </em></p>
          <p>Tempat: <em>Jambur Serba Guna in Berastagi
Jalan Udara 22152 Berastagi North Sumatra </em></p>
        </article>
      </div>

      <p style="margin:25px auto 15px">
        Kami menantikan kehadiran dan doa restu Anda.
      </p>

      <a class="button" id="mapButton"
         href="https://maps.google.com/"
         target="_blank" rel="noopener">
        Buka Google Maps
      </a>
    </div>
  </section>

  <!-- GALERI FOTO -->
  <section class="section" id="gallery">
    <div class="container">
      <p class="eyebrow">Our Moments</p>
      <h2>Galeri Kami</h2>
      <div class="ornament">❧ ✿ ❧</div>

      <div class="gallery-grid">
        <img
          src="https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=800&q=80"
          alt="Dekorasi pernikahan"
          loading="lazy">

        <img
          src="https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=800&q=80"
          alt="Momen pernikahan"
          loading="lazy">

        <img
          src="https://images.unsplash.com/photo-1532712938310-34cb3982ef74?auto=format&fit=crop&w=800&q=80"
          alt="Suasana pesta pernikahan"
          loading="lazy">

        <img
          src="https://images.unsplash.com/photo-1464366400600-7168b8af9bc3?auto=format&fit=crop&w=800&q=80"
          alt="Dekorasi acara"
          loading="lazy">
      </div>

      <p class="gallery-note">
        Foto di atas masih foto contoh. Nantinya kita ganti dengan foto Ari dan Gina.
      </p>
    </div>
  </section>

  <!-- RSVP -->
  <section class="section rsvp" id="rsvp">
    <div class="container">
      <p class="eyebrow">Konfirmasi Kehadiran</p>
      <h2>RSVP</h2>
      <div class="ornament">❧ ✿ ❧</div>

      <p>
        Mohon konfirmasi kehadiran Anda melalui WhatsApp.
      </p>

      <form id="rsvpForm">
        <label for="name">Nama</label>
        <input id="name" name="name" required
               placeholder="Masukkan nama Anda">

        <label for="attendance">Konfirmasi Kehadiran</label>
        <select id="attendance" name="attendance" required>
          <option value="">Pilih jawaban</option>
          <option value="Hadir">InsyaAllah hadir</option>
          <option value="Tidak dapat hadir">Mohon maaf, tidak dapat hadir</option>
        </select>

        <label for="count">Jumlah tamu</label>
        <select id="count" name="count">
          <option value="1 orang">1 orang</option>
          <option value="2 orang">2 orang</option>
          <option value="3 orang">3 orang</option>
          <option value="4 orang">4 orang</option>
        </select>

        <label for="message">Ucapan dan doa</label>
        <textarea id="message" name="message" rows="3"
                  placeholder="Tuliskan doa terbaik Anda"></textarea>

        <button class="button" type="submit">
          Kirim Konfirmasi WhatsApp
        </button>
      </form>
    </div>
  </section>

  <!-- PENUTUP -->
  <section class="section closing">
    <div class="container">
      <p class="eyebrow">Terima Kasih</p>
      <h2>Ari & Gina</h2>
      <div class="ornament">✿ ❧ ✿</div>

      <p>
        Merupakan kebahagiaan bagi kami apabila Anda berkenan hadir
        dan memberikan doa restu kepada kami.
      </p>

      <p style="margin-top:20px">
        Wassalamu'alaikum Warahmatullahi Wabarakatuh.
      </p>

      <p style="margin-top:30px;font-family:'Cormorant Garamond',serif;font-size:1.6rem">
        07 . 11 . 2026
      </p>
    </div>
  </section>

  <footer>
    <p>Made with love — Ari & Gina © 2026</p>
  </footer>

  <!-- AUDIO: musik belum diaktifkan sampai file MP3 ditambahkan -->
  <audio id="weddingMusic" loop preload="none"></audio>
  <button class="music-button" id="musicButton"
          type="button" aria-label="Kontrol musik"
          title="Musik belum ditambahkan">♫</button>

  <script>
    // BUKA UNDANGAN
    document.getElementById('openInvitation').addEventListener('click', () => {
      document.getElementById('couple').scrollIntoView({
        behavior: 'smooth'
      });
    });

    // NAMA TAMU DARI LINK
    // Contoh: index.html?to=Bapak%20Budi
    const params = new URLSearchParams(window.location.search);
    const guest = params.get('to');

    if (guest) {
      document.getElementById('guestName').textContent = guest;
    }

    // HITUNG MUNDUR
    // Waktu dihitung berdasarkan tanggal dan zona waktu WIB.
    const weddingDate = new Date('2026-11-07T00:00:00+07:00').getTime();

    function updateCountdown() {
      const now = Date.now();
      const distance = weddingDate - now;

      if (distance <= 0) {
        document.getElementById('days').textContent = '0';
        document.getElementById('hours').textContent = '0';
        document.getElementById('minutes').textContent = '0';
        document.getElementById('seconds').textContent = '0';
        return;
      }

      document.getElementById('days').textContent =
        Math.floor(distance / 86400000);

      document.getElementById('hours').textContent =
        Math.floor((distance % 86400000) / 3600000);

      document.getElementById('minutes').textContent =
        Math.floor((distance % 3600000) / 60000);

      document.getElementById('seconds').textContent =
        Math.floor((distance % 60000) / 1000);
    }

    updateCountdown();
    setInterval(updateCountdown, 1000);

    // RSVP MELALUI WHATSAPP
    document.getElementById('rsvpForm').addEventListener('submit', function(e) {
      e.preventDefault();

      const name = document.getElementById('name').value.trim();
      const attendance = document.getElementById('attendance').value;
      const count = document.getElementById('count').value;
      const message = document.getElementById('message').value.trim();

      // GANTI DENGAN NOMOR WHATSAPP PENERIMA.
      // Format: kode negara + nomor, tanpa tanda +, spasi, atau strip.
      const whatsappNumber = 'GANTI_DENGAN_NOMOR_WHATSAPP';

      if (!/^\d{10,15}$/.test(whatsappNumber)) {
        alert('RSVP belum aktif. Nomor WhatsApp penerima perlu diatur dahulu.');
        return;
      }

      const text =
        'RSVP Undangan Ari & Gina\n\n' +
        'Nama: ' + name + '\n' +
        'Kehadiran: ' + attendance + '\n' +
        'Jumlah tamu: ' + count + '\n' +
        'Ucapan: ' + (message || '-') ;

      const url = 'https://wa.me/' + whatsappNumber +
        '?text=' + encodeURIComponent(text);

      window.open(url, '_blank', 'noopener');
    });

    // MUSIK LATAR
    // Musik akan aktif setelah file musik.mp3 tersedia.
    const music = document.getElementById('weddingMusic');
    const musicButton = document.getElementById('musicButton');

    musicButton.addEventListener('click', async () => {
      if (!music.getAttribute('src')) {
        alert('Musik belum ditambahkan. Kita bisa menambahkannya nanti.');
        return;
      }

      try {
        if (music.paused) {
          await music.play();
          musicButton.textContent = '❚❚';
        } else {
          music.pause();
          musicButton.textContent = '♫';
        }
      } catch (error) {
        alert('Musik tidak dapat diputar. Silakan coba kembali.');
      }
    });
  </script>

</body>
</html>
